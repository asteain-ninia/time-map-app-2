{
  "name": "time-map-app",
  "version": "1.0.0",
  "description": "時間軸に沿って地図を管理するアプリケーション",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build": "webpack --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch & electron .",
    "package": "electron-builder --win --mac --linux",
    "test": "vitest"
  },
  "build": {
    "appId": "com.yourcompany.timemapapp",
    "productName": "時空地図アプリケーション",
    "files": [
      "dist/**/*",
      "public/**/*",
      "electron-main.js",
      "preload.js"
    ],
    "directories": {
      "output": "release"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@babel/preset-env": "^7.26.9",
    "babel-loader": "^10.0.0",
    "electron": "^35.0.1",
    "electron-builder": "^26.0.12",
    "vitest": "^3.2.4",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "polygon-clipping": "^0.15.7"
  }
}
